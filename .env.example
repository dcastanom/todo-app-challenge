# ─────────────────────────────────────────────────────────────
# Copy to .env and adjust. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ── PostgreSQL ───────────────────────────────────────────────
# Used by docker-compose to provision the container:
POSTGRES_USER=todo
POSTGRES_PASSWORD=todo_dev_password
POSTGRES_DB=todolist_dev
POSTGRES_PORT=5432
# Consumed by the backend (Drizzle):
DATABASE_URL=postgresql://todo:todo_dev_password@localhost:5432/todolist_dev

# ── Redis ────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── Auth / JWT ───────────────────────────────────────────────
# Generate real secrets with: openssl rand -hex 32
JWT_SECRET=dev-access-secret-change-me-0000000000000000000000000000
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-000000000000000000000000000
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ── HTTP / CORS / Rate limiting ──────────────────────────────
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Frontend (Vite - must be prefixed with VITE_) ────────────
VITE_API_BASE_URL=http://localhost:3000/api/v1
