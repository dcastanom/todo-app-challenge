{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "title": "Todo Backend",
  "uid": "todo-backend",
  "tags": ["todo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Request rate (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (route) (rate(http_request_duration_seconds_count{service=\"todo-backend\"}[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "p95 latency by route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket{service=\"todo-backend\"}[5m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "5xx / 4xx rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_seconds_count{service=\"todo-backend\",status=~\"5..\"}[5m]))",
          "legendFormat": "5xx"
        },
        {
          "expr": "sum(rate(http_request_duration_seconds_count{service=\"todo-backend\",status=~\"4..\"}[5m]))",
          "legendFormat": "4xx"
        }
      ]
    },
    {
      "id": 4,
      "title": "Event loop lag (p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "nodejs_eventloop_lag_p99_seconds{service=\"todo-backend\"}",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 5,
      "title": "Heap used",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "nodejs_heap_size_used_bytes{service=\"todo-backend\"}",
          "legendFormat": "heap used"
        }
      ]
    },
    {
      "id": 6,
      "title": "Process CPU",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{service=\"todo-backend\"}[5m])",
          "legendFormat": "cpu"
        }
      ]
    },
    {
      "id": 7,
      "title": "Logs (backend)",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 24 },
      "options": { "showTime": true, "wrapLogMessage": true, "prettifyLogMessage": true },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service=\"backend\"}"
        }
      ]
    }
  ]
}
