{
  "name": "fullstack-todo-challenge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Full-stack Todo application - React + Node.js + PostgreSQL",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "backend",
    "frontend",
    "e2e"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace @todo/shared",
    "build": "npm run build --workspaces --if-present",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspace backend --workspace frontend",
    "test:e2e": "npm run e2e --workspace @todo/e2e",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres redis",
    "prepare": "husky || true"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
